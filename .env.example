# Copy this file to `.env` and replace placeholders with real values.
# Connection string for PostgreSQL (Requires PostgreSQL >= 15).

NODE_ENV="development"
PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/velodruh"
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,https://velodruh.ua"

# Catalog read backend: "memory" (curated in-repo dataset) or "postgres" (ETL-populated DB)
CATALOG_SOURCE="memory"

# ReefAPI (optional — required ONLY for one-time live ETL execution with `--execute`)
REEFAPI_BASE_URL="https://api.reefapi.com"
REEFAPI_API_KEY=""
